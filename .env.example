APP_NAME=MezquitaAlQuds
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Generate with: php artisan key:generate
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mezquita_alquds
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=lax

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Admin seeder password (change in production)
ADMIN_PASSWORD=changeme_please

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@mezquita-alquds.cat
MAIL_FROM_NAME="${APP_NAME}"

# For production, set these to the production URL
VITE_APP_URL="${APP_URL}"
